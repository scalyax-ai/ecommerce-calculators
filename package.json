{
  "name": "ecommerce-calculators",
  "version": "0.1.0",
  "description": "35 tested ecommerce calculators: ROAS and break-even ROAS, COD profit after RTO, max CPA, MER, contribution margin, CLV, CAC payback, discount impact, free-shipping threshold, reorder point and more. Zero dependencies.",
  "keywords": [
    "ecommerce",
    "calculator",
    "roas",
    "break-even-roas",
    "cod",
    "rto",
    "cash-on-delivery",
    "profit",
    "margin",
    "cac",
    "ltv",
    "clv",
    "mer",
    "shopify",
    "unit-economics"
  ],
  "homepage": "https://analify-ai.scalyax.ai/tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalyax-ai/ecommerce-calculators.git"
  },
  "bugs": {
    "url": "https://github.com/scalyax-ai/ecommerce-calculators/issues"
  },
  "license": "MIT",
  "author": "Analify AI (https://analify-ai.scalyax.ai)",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
